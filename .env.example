# Copy this file, name the copy ".env" (just .env, nothing before the dot) and paste the real link.
# Get the real link from Nala privately (NOT via GitHub). The .env file is never pushed.
#
# With this line: everyone uses the same shared database in the cloud.
# Without it (or without a .env file): you get your own local db.sqlite3.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
